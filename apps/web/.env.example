# BIM Guard Frontend Environment Variables

# API base URL for backend requests.
# In development the Next.js rewrite proxy (next.config.ts) is used by default,
# so this variable only needs to be set when deploying to staging or production.
# The value should be the base without a trailing slash; paths like
# /compliance/ingest and /compliance/check will be appended automatically.
# Example: https://api.your-domain.com/api/v1
# NEXT_PUBLIC_API_BASE_URL=
